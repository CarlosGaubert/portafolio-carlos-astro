---
import Layout from "@/layouts/Layout.astro";
import { slide } from "astro:transitions";
import CardProject from "@/components/CardProject.astro";

let repos = [];
try {
  const response = await fetch(
    "https://api.github.com/users/CarlosGaubert/repos?sort=updated&per_page=100"
  );
  if (response.ok) {
    const rawRepos = await response.json();
    repos = Array.isArray(rawRepos) ? rawRepos.filter((repo: any) => !repo.fork) : [];
  }
} catch (error) {
  console.error("Error fetching GitHub repos, using fallback:", error);
}

if (!repos || repos.length === 0) {
  repos = [
    {
      name: "portafolio-carlos-astro",
      description: "Portafolio de proyectos de Carlos Gaubert. Desarrollado con astro y tailwindcss.",
      html_url: "https://github.com/CarlosGaubert/portafolio-carlos-astro",
      language: "Astro",
    },
    {
      name: "tesisgaubert",
      description: "Algoritmo de clasificación de imágenes satelitales y visualización del comportamiento de modelos VIT.",
      html_url: "https://github.com/CarlosGaubert/tesisgaubert",
      language: "Python",
    },
  ];
}

const getImageForLanguage = (language: string, name: string) => {
  const lang = (language || "").toLowerCase();
  const repoName = (name || "").toLowerCase();

  if (lang === "astro" || repoName.includes("astro")) {
    return "/portafolio-carlos-astro/repositories/astro.webp";
  }
  if (lang === "python") {
    return "/portafolio-carlos-astro/repositories/pytorch.png";
  }
  if (lang === "react" || repoName.includes("react")) {
    return "/portafolio-carlos-astro/repositories/React.png";
  }
  if (lang === "javascript" || lang === "typescript" || repoName.includes("node")) {
    return "/portafolio-carlos-astro/repositories/node.png";
  }
  if (lang === "java" || lang === "kotlin" || repoName.includes("android")) {
    return "/portafolio-carlos-astro/repositories/javaandroid.jpeg";
  }

  return "/portafolio-carlos-astro/github.webp";
};
---

<Layout title="Experiencia">
  <div
    class="grid justify-center items-center
      lg:grid-cols-2 xl:grid-cols-3 grid-cols-1 pl-10 pr-10 gap-y-10 pt-32 pb-32"
    transition:animate={slide({
      duration: "1s",
    })}
    transition:name="main"
  >
    {
      repos.map((repo: any) => (
        <CardProject
          nameProject={repo.name}
          descriptionProject={repo.description || "Sin descripción disponible."}
          patchImage={getImageForLanguage(repo.language, repo.name)}
          githubUrl={repo.html_url}
        />
      ))
    }
  </div>
</Layout>
<style>
  main {
    margin: auto;
  }

  .adelante {
    z-index: 100;
  }
</style>


