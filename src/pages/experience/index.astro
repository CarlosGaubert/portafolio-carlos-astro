---
import Layout from "@/layouts/Layout.astro";
import { slide } from "astro:transitions";
import { experiences } from "@/lib/dataExperience";
import ItemExperience from "@/components/ItemExperience.astro";
---

<Layout title="Experiencia | Carlos Gaubert">
  <main
    transition:name="main"
    transition:animate={slide({
      duration: "0.8s",
    })}
    class="min-h-screen w-full pt-28 pb-24 px-4 sm:px-8 max-w-5xl mx-auto flex flex-col items-center"
  >
    <!-- Encabezado de la Sección -->
    <header class="w-full text-center max-w-3xl mb-12 flex flex-col items-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-900/80 border border-zinc-800 text-xs font-semibold text-[#00ccff] mb-4 shadow-sm backdrop-blur-md">
        <svg class="w-3.5 h-3.5 text-[#00ccff]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span>Trayectoria Profesional</span>
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-transparent bg-clip-text bg-gradient-to-r from-white via-zinc-200 to-zinc-400 tracking-tight">
        Mi <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#00ccff] to-[#d500f9]">Experiencia</span>
      </h1>
      <p class="text-zinc-400 text-sm sm:text-base mt-3 max-w-2xl">
        Un recorrido por mi carrera profesional en desarrollo de software, investigación en inteligencia artificial, liderazgo técnico y optimización de sistemas.
      </p>
    </header>

    <!-- Línea de Tiempo de Experiencias -->
    <section class="w-full relative">
      <ol class="relative w-full">
        {
          experiences.map((experience) => (
            <ItemExperience
              dateExperience={experience.dateExperience}
              titleExperience={experience.titleExperience}
              descriptionExperience={experience.descriptionExperience}
              companyExperience={experience.companyExperience}
              cityCompanyExperience={experience.cityCompanyExperience}
              isCurrent={experience.isCurrent}
              technologies={experience.technologies}
            />
          ))
        }
      </ol>
    </section>

    <!-- Tarjeta de Resumen / CTA -->
    <section class="w-full mt-8 bg-gradient-to-r from-zinc-950/90 via-zinc-900/90 to-zinc-950/90 border border-zinc-800 rounded-2xl p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 backdrop-blur-xl shadow-2xl">
      <div class="flex flex-col text-center sm:text-left">
        <h3 class="text-lg font-bold text-white">¿Tienes un proyecto en mente o buscas un perfil con esta experiencia?</h3>
        <p class="text-xs sm:text-sm text-zinc-400 mt-1">Hablemos sobre cómo puedo aportar valor técnico a tu equipo u organización.</p>
      </div>
      <a
        href="/portafolio-carlos-astro/contact/"
        class="flex-shrink-0 px-6 py-3 rounded-xl bg-gradient-to-r from-[#00ccff] to-[#d500f9] text-white text-sm font-bold shadow-[0_0_20px_rgba(0,204,255,0.3)] hover:shadow-[0_0_30px_rgba(213,0,249,0.5)] transition-all transform hover:scale-105"
      >
        Contactar Ahora
      </a>
    </section>
  </main>
</Layout>



