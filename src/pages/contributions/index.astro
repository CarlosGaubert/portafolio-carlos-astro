---
import Layout from "@/layouts/Layout.astro";
import GithubContributions from "@/components/GithubContributions.astro";
import { slide } from "astro:transitions";
---

<Layout title="Contribuciones | Carlos Gaubert">
  <main
    class="min-h-screen w-full pt-28 pb-24 px-4 sm:px-8 max-w-7xl mx-auto flex flex-col items-center"
    transition:animate={slide({
      duration: "0.8s",
    })}
    transition:name="main"
  >
    <!-- Encabezado de la Sección -->
    <header class="w-full text-center max-w-3xl mb-10 flex flex-col items-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-900/80 border border-zinc-800 text-xs font-semibold text-[#00ccff] mb-4 shadow-sm backdrop-blur-md">
        <svg class="w-4 h-4 fill-current text-[#00ccff]" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
        <span>Actividad en GitHub</span>
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-transparent bg-clip-text bg-gradient-to-r from-white via-zinc-200 to-zinc-400 tracking-tight">
        Mis <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#00ccff] to-[#d500f9]">Contribuciones</span>
      </h1>
      <p class="text-zinc-400 text-sm sm:text-base mt-3 max-w-2xl">
        Registro continuo de actividad, avances, commits y repositorios de código abierto sincronizados directamente desde mi cuenta oficial.
      </p>
    </header>

    <!-- Calendario Interactivo de Contribuciones -->
    <GithubContributions username="CarlosGaubert" />

    <!-- Sección Informativa / Tarjetas de Resumen -->
    <section class="w-full grid grid-cols-1 md:grid-cols-3 gap-6 mt-2">
      <div class="p-5 rounded-2xl bg-zinc-950/60 border border-zinc-800/80 backdrop-blur-xl flex flex-col justify-between shadow-lg">
        <div>
          <div class="w-9 h-9 rounded-xl bg-[#00ccff]/10 border border-[#00ccff]/20 flex items-center justify-center text-[#00ccff] mb-3">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-white mb-1">Sincronización Continua</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Las contribuciones se obtienen de manera dinámica directamente de GitHub, garantizando que los avances se reflejen en tiempo real.
          </p>
        </div>
      </div>

      <div class="p-5 rounded-2xl bg-zinc-950/60 border border-zinc-800/80 backdrop-blur-xl flex flex-col justify-between shadow-lg">
        <div>
          <div class="w-9 h-9 rounded-xl bg-[#d500f9]/10 border border-[#d500f9]/20 flex items-center justify-center text-[#d500f9] mb-3">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-white mb-1">Proyectos y Repositorios</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Puedes explorar el código fuente completo, tecnologías aplicadas y detalles de cada proyecto en el menú dedicado de proyectos.
          </p>
        </div>
        <a
          href="/portafolio-carlos-astro/projects/"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#00ccff] hover:text-[#d500f9] transition-colors mt-4"
        >
          <span>Ir a Proyectos</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <div class="p-5 rounded-2xl bg-zinc-950/60 border border-zinc-800/80 backdrop-blur-xl flex flex-col justify-between shadow-lg">
        <div>
          <div class="w-9 h-9 rounded-xl bg-white/10 border border-white/20 flex items-center justify-center text-white mb-3">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
            </svg>
          </div>
          <h3 class="text-base font-bold text-white mb-1">Perfil Oficial de GitHub</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Visita mi perfil en GitHub para revisar estrellas, organizaciones, forks y actividad detallada de contribución.
          </p>
        </div>
        <a
          href="https://github.com/CarlosGaubert"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-zinc-300 hover:text-white transition-colors mt-4"
        >
          <span>github.com/CarlosGaubert</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </section>
  </main>
</Layout>
