---
import Layout from "@/layouts/Layout.astro";
import CardProject from "@/components/CardProject.astro";
import { getTechIconUrl, getMainLanguage, defaultProjects } from "@/lib/dataProjects";
import { slide } from "astro:transitions";

let projects: any[] = [];
try {
  const response = await fetch(
    "https://api.github.com/users/CarlosGaubert/repos?sort=updated&per_page=100"
  );
  if (response.ok) {
    const rawRepos = await response.json();
    const repos = Array.isArray(rawRepos) ? rawRepos.filter((repo: any) => !repo.fork) : [];
    projects = repos.map((repo: any) => {
      const description = repo.description || "Sin descripción disponible.";
      const language = getMainLanguage(repo.language, repo.name, description);
      return {
        nameProject: repo.name,
        descriptionProject: description,
        githubUrl: repo.html_url,
        language: language,
      };
    });
  }
} catch (error) {
  console.error("Error fetching GitHub repos during build:", error);
}

// Si la API de GitHub falló o tiene rate limit en GitHub Actions, usar lista representativa por defecto
if (!projects || projects.length === 0) {
  projects = defaultProjects;
}

// Extraer lista única de lenguajes de programación para los botones de filtrado
const allLanguages = Array.from(
  new Set(projects.map((p: any) => p.language))
).filter(Boolean).sort((a: any, b: any) => a.localeCompare(b));
---

<Layout title="Proyectos | Carlos Gaubert">
  <main
    class="min-h-screen w-full pt-28 pb-24 px-4 sm:px-8 max-w-7xl mx-auto flex flex-col items-center"
    transition:animate={slide({
      duration: "0.8s",
    })}
    transition:name="main"
  >
    <!-- Encabezado de la Sección -->
    <header class="w-full text-center max-w-3xl mb-10 flex flex-col items-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-900/80 border border-zinc-800 text-xs font-semibold text-[#00ccff] mb-4 shadow-sm backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-[#00ccff] animate-ping"></span>
        <span id="github-sync-badge">Repositorios de GitHub</span>
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-transparent bg-clip-text bg-gradient-to-r from-white via-zinc-200 to-zinc-400 tracking-tight">
        Mis <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#00ccff] to-[#d500f9]">Proyectos</span>
      </h1>
      <p class="text-zinc-400 text-sm sm:text-base mt-3 max-w-2xl">
        Explora mis repositorios y proyectos sincronizados directamente desde mi GitHub oficial. Puedes ordenar y filtrar interactivamente.
      </p>
    </header>

    <!-- Barra de Controles: Ordenamiento, Filtros y Búsqueda -->
    <section class="controls-section w-full mb-10 bg-zinc-950/60 border border-zinc-800/80 backdrop-blur-xl rounded-2xl p-4 sm:p-6 shadow-2xl">
      <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4">
        <!-- Buscador en tiempo real -->
        <div class="relative flex-1 max-w-md">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-zinc-500">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            type="text"
            id="search-input"
            placeholder="Buscar proyecto por nombre o descripción..."
            class="w-full pl-10 pr-4 py-2.5 bg-zinc-900/90 border border-zinc-800 rounded-xl text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-[#00ccff] focus:ring-1 focus:ring-[#00ccff] transition-all"
          />
        </div>

        <!-- Botones de Ordenamiento -->
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs font-semibold text-zinc-400 uppercase tracking-wider mr-1">Ordenar por:</span>
          
          <button
            type="button"
            class="sort-btn active-sort px-3 py-1.5 text-xs font-medium rounded-lg border transition-colors flex items-center gap-1.5 cursor-pointer"
            data-sort="name-asc"
          >
            <span>Nombre (A-Z)</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12" />
            </svg>
          </button>

          <button
            type="button"
            class="sort-btn px-3 py-1.5 text-xs font-medium rounded-lg border transition-colors flex items-center gap-1.5 cursor-pointer"
            data-sort="name-desc"
          >
            <span>Nombre (Z-A)</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h9m5-4v12m0 0l-4-4m4 4l4-4" />
            </svg>
          </button>

          <button
            type="button"
            class="sort-btn px-3 py-1.5 text-xs font-medium rounded-lg border transition-colors flex items-center gap-1.5 cursor-pointer"
            data-sort="tech-asc"
          >
            <span>Lenguaje (A-Z)</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Filtros rápidos únicamente por Lenguaje de Programación -->
      <div id="filter-tags-container" class="mt-4 pt-4 border-t border-zinc-800/60 flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none">
        <span class="text-xs font-semibold text-zinc-400 uppercase tracking-wider flex-shrink-0">Filtrar por Lenguaje:</span>
        <button
          type="button"
          class="filter-tag-btn active-filter px-3 py-1 text-xs rounded-full border transition-colors flex-shrink-0"
          data-filter="all"
        >
          Todos ({projects.length})
        </button>
        {allLanguages.map((lang: string) => (
          <button
            type="button"
            class="filter-tag-btn px-3 py-1 text-xs rounded-full border transition-colors flex-shrink-0 flex items-center gap-1.5"
            data-filter={lang.toLowerCase()}
          >
            <img
              src={getTechIconUrl(lang)}
              alt=""
              class="w-3 h-3 object-contain"
              onerror="this.style.display='none'"
            />
            <span>{lang}</span>
          </button>
        ))}
      </div>
    </section>

    <!-- Contador de resultados -->
    <div class="w-full flex justify-between items-center mb-6 px-2 text-xs text-zinc-400">
      <div>
        Mostrando <span id="visible-count" class="font-bold text-[#00ccff]">{projects.length}</span> de <span id="total-count" class="font-bold">{projects.length}</span> proyectos
      </div>
      <div id="sort-status" class="italic text-zinc-500">
        Orden: Nombre (A-Z)
      </div>
    </div>

    <!-- Grid de Proyectos -->
    <div
      id="projects-grid"
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 w-full justify-items-center"
    >
      {
        projects.map((repo: any, index: number) => (
          <CardProject
            nameProject={repo.nameProject}
            descriptionProject={repo.descriptionProject}
            githubUrl={repo.githubUrl}
            language={repo.language}
            index={index}
          />
        ))
      }
    </div>

    <!-- Mensaje de no resultados -->
    <div
      id="no-results"
      class="hidden flex-col items-center justify-center py-20 text-center w-full"
    >
      <div class="w-16 h-16 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-500 mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <p class="text-lg font-semibold text-zinc-300">No se encontraron proyectos</p>
      <p class="text-sm text-zinc-500 mt-1">Intenta con otro término de búsqueda o selecciona "Todos".</p>
      <button
        id="reset-filter-btn"
        class="mt-4 px-4 py-2 text-xs font-semibold text-white bg-gradient-to-r from-[#00ccff] to-[#d500f9] rounded-lg shadow-md hover:opacity-90 transition-opacity"
      >
        Restablecer filtros
      </button>
    </div>
    <!-- Script de datos iniciales para sincronización inmediata -->
    <script id="initial-projects-data" is:inline type="application/json" set:html={JSON.stringify(projects)}></script>
  </main>
</Layout>

<script is:inline>
  function setupProjectControls() {
    const grid = document.getElementById("projects-grid");
    if (!grid) return;

    const dataEl = document.getElementById("initial-projects-data");
    let allProjects = [];
    try {
      if (dataEl && dataEl.textContent) {
        allProjects = JSON.parse(dataEl.textContent);
      }
    } catch (e) {
      console.error("Error parsing initial projects data:", e);
    }

    const controlsSection = document.querySelector(".controls-section");
    const searchInput = document.getElementById("search-input");
    const visibleCountEl = document.getElementById("visible-count");
    const totalCountEl = document.getElementById("total-count");
    const sortStatusEl = document.getElementById("sort-status");
    const noResultsEl = document.getElementById("no-results");
    const resetBtn = document.getElementById("reset-filter-btn");

    let currentSort = "name-asc";
    let currentFilter = "all";
    let currentSearch = "";

    // Mapeo unificado de iconos Devicon
    function getTechIcon(t) {
      const name = (t || "").toLowerCase().trim();
      const map = {
        python: "python/python-original.svg",
        django: "django/django-plain.svg",
        pytorch: "pytorch/pytorch-original.svg",
        java: "java/java-original.svg",
        android: "android/android-original.svg",
        astro: "astro/astro-original.svg",
        tailwindcss: "tailwindcss/tailwindcss-original.svg",
        tailwind: "tailwindcss/tailwindcss-original.svg",
        react: "react/react-original.svg",
        reactjs: "react/react-original.svg",
        nodejs: "nodejs/nodejs-original.svg",
        "node.js": "nodejs/nodejs-original.svg",
        node: "nodejs/nodejs-original.svg",
        sequelize: "sequelize/sequelize-original.svg",
        opencv: "opencv/opencv-original.svg",
        javascript: "javascript/javascript-original.svg",
        typescript: "typescript/typescript-original.svg",
        html: "html5/html5-original.svg",
        html5: "html5/html5-original.svg",
        css: "css3/css3-original.svg",
        css3: "css3/css3-original.svg",
        docker: "docker/docker-original.svg",
        csharp: "csharp/csharp-original.svg",
        "c#": "csharp/csharp-original.svg",
        cplusplus: "cplusplus/cplusplus-original.svg",
        "c++": "cplusplus/cplusplus-original.svg",
        c: "c/c-original.svg",
        go: "go/go-original.svg",
        rust: "rust/rust-original.svg",
        php: "php/php-original.svg",
        ruby: "ruby/ruby-original.svg",
        swift: "swift/swift-original.svg",
        kotlin: "kotlin/kotlin-original.svg",
        vue: "vuejs/vuejs-original.svg",
        "vue.js": "vuejs/vuejs-original.svg",
        nextjs: "nextjs/nextjs-original.svg",
        "next.js": "nextjs/nextjs-original.svg",
        shell: "bash/bash-original.svg",
        bash: "bash/bash-original.svg"
      };
      const p = map[name] || `${name}/${name}-original.svg`;
      return `https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/${p}`;
    }

    // Gradientes temáticos según tecnología
    function getGradient(tech) {
      const n = (tech || "").toLowerCase().trim();
      if (n === "python") return "from-blue-950/70 via-slate-900/80 to-yellow-950/30";
      if (n === "react" || n === "reactjs") return "from-cyan-950/80 via-zinc-900/80 to-blue-950/50";
      if (n === "astro") return "from-purple-950/80 via-zinc-900/80 to-orange-950/40";
      if (n === "nodejs" || n === "node.js" || n === "node") return "from-emerald-950/80 via-zinc-900/80 to-green-950/40";
      if (n === "typescript") return "from-blue-950/80 via-zinc-900/80 to-indigo-950/50";
      if (n === "javascript") return "from-yellow-950/70 via-zinc-900/80 to-amber-950/40";
      if (n === "java" || n === "android" || n === "kotlin") return "from-amber-950/70 via-zinc-900/80 to-red-950/40";
      if (n === "pytorch" || n === "django") return "from-red-950/70 via-zinc-900/80 to-orange-950/40";
      if (n === "opencv") return "from-emerald-950/70 via-zinc-900/80 to-blue-950/50";
      return "from-zinc-900/90 via-zinc-950/90 to-zinc-900/90";
    }

    function extractMainLang(lang, name, desc) {
      if (lang && lang.trim().length > 0) return lang.trim();
      const n = (name || "").toLowerCase();
      const d = (desc || "").toLowerCase();
      if (n.includes("python") || d.includes("python")) return "Python";
      if (n.includes("react") || d.includes("react")) return "JavaScript";
      if (n.includes("astro") || d.includes("astro")) return "Astro";
      if (n.includes("android") || d.includes("android")) return "Java";
      if (n.includes("node") || d.includes("node")) return "JavaScript";
      if (n.includes("typescript") || n.includes("ts")) return "TypeScript";
      return "General";
    }

    function renderFilterButtons() {
      const filterContainer = document.getElementById("filter-tags-container");
      if (!filterContainer) return;

      const langs = Array.from(
        new Set(allProjects.map((p) => p.language).filter(Boolean))
      ).sort((a, b) => a.localeCompare(b));

      let html = `
        <span class="text-xs font-semibold text-zinc-400 uppercase tracking-wider flex-shrink-0">Filtrar por Lenguaje:</span>
        <button
          type="button"
          class="filter-tag-btn ${currentFilter === "all" ? "active-filter" : ""} px-3 py-1 text-xs rounded-full border transition-colors flex-shrink-0 cursor-pointer"
          data-filter="all"
        >
          Todos (${allProjects.length})
        </button>
      `;

      langs.forEach((lang) => {
        const isActive = currentFilter.toLowerCase() === lang.toLowerCase();
        const count = allProjects.filter(
          (p) => (p.language || "").toLowerCase() === lang.toLowerCase()
        ).length;

        html += `
          <button
            type="button"
            class="filter-tag-btn ${isActive ? "active-filter" : ""} px-3 py-1 text-xs rounded-full border transition-colors flex-shrink-0 flex items-center gap-1.5 cursor-pointer"
            data-filter="${lang.toLowerCase()}"
          >
            <img
              src="${getTechIcon(lang)}"
              alt=""
              class="w-3 h-3 object-contain"
              onerror="this.style.display='none'"
            />
            <span>${lang} (${count})</span>
          </button>
        `;
      });

      filterContainer.innerHTML = html;
    }

    function renderProjects() {
      // 1. Filtrar
      const searchTerms = currentSearch.toLowerCase().trim();
      const filtered = allProjects.filter((p) => {
        const tech = (p.language || "General").toLowerCase();
        const matchesFilter =
          currentFilter === "all" ||
          tech === currentFilter.toLowerCase();

        const name = (p.nameProject || "").toLowerCase();
        const desc = (p.descriptionProject || "").toLowerCase();
        const matchesSearch =
          !searchTerms ||
          name.includes(searchTerms) ||
          tech.includes(searchTerms) ||
          desc.includes(searchTerms);

        return matchesFilter && matchesSearch;
      });

      // 2. Ordenar
      filtered.sort((a, b) => {
        const nameA = (a.nameProject || "").toLowerCase();
        const nameB = (b.nameProject || "").toLowerCase();
        const techA = (a.language || "").toLowerCase();
        const techB = (b.language || "").toLowerCase();

        if (currentSort === "name-asc") return nameA.localeCompare(nameB);
        if (currentSort === "name-desc") return nameB.localeCompare(nameA);
        if (currentSort === "tech-asc") {
          const c = techA.localeCompare(techB);
          return c !== 0 ? c : nameA.localeCompare(nameB);
        }
        return 0;
      });

      // 3. Renderizar Tarjetas con animación escalonada
      grid.innerHTML = filtered
        .map((repo, index) => {
          const name = repo.nameProject;
          const desc = repo.descriptionProject || "Sin descripción disponible.";
          const primaryLang = repo.language || "General";
          const primaryIconUrl = getTechIcon(primaryLang);
          const gradientClass = getGradient(primaryLang);
          const delayMs = Math.min(index * 35, 350);

          return `
            <div
              class="project-card box place-self-center grid-item w-full max-w-[400px]"
              data-name="${name.toLowerCase()}"
              data-tech="${primaryLang.toLowerCase()}"
              style="--card-delay: ${delayMs}ms;"
            >
              <!-- Header / Banner de Tecnología -->
              <div class="tech-banner w-full h-28 z-20 overflow-hidden rounded-t-[16px] relative bg-gradient-to-br ${gradientClass} flex items-center justify-between px-6 border-b border-zinc-800/80">
                <div class="flex items-center gap-3.5 z-10">
                  <div class="w-12 h-12 rounded-xl bg-zinc-950/80 border border-white/10 p-2 flex items-center justify-center shadow-lg backdrop-blur-md">
                    <img
                      src="${primaryIconUrl}"
                      alt="${primaryLang}"
                      class="w-8 h-8 object-contain filter drop-shadow"
                      onerror="this.style.display='none'"
                    />
                  </div>
                  <div class="flex flex-col">
                    <span class="text-xs font-semibold uppercase tracking-wider text-zinc-400">Lenguaje</span>
                    <span class="text-sm font-bold text-white tracking-wide">${primaryLang}</span>
                  </div>
                </div>

                <!-- Píldora de estado -->
                <div class="hidden sm:flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-black/40 border border-white/10 text-[10px] font-mono text-zinc-300 backdrop-blur-sm z-10">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#00ccff]"></span>
                  <span>Repo</span>
                </div>

                <div class="absolute -right-8 -top-8 w-24 h-24 bg-[#00ccff]/10 rounded-full blur-2xl pointer-events-none"></div>
              </div>

              <!-- Contenido de la Tarjeta -->
              <div class="relative w-full flex flex-col flex-1 p-5 z-20">
                <div class="flex flex-row justify-between items-start gap-2">
                  <h3 class="text-lg font-bold text-white tracking-wide line-clamp-1 hover:text-[#00ccff] transition-colors" title="${name}">
                    ${name}
                  </h3>

                  ${
                    repo.githubUrl
                      ? `<a
                          href="${repo.githubUrl}"
                          target="_blank"
                          rel="noopener noreferrer"
                          class="github-icon flex-shrink-0 flex items-center justify-center p-2 rounded-xl bg-zinc-800/90 hover:bg-[#00ccff]/20 border border-zinc-600 hover:border-[#00ccff] text-white hover:text-[#00ccff] transition-all duration-300 transform hover:scale-110 shadow-md"
                          title="Ver repositorio en GitHub"
                          aria-label="Ver repositorio de ${name} en GitHub"
                        >
                          <svg class="w-5 h-5 fill-current text-white" viewBox="0 0 24 24" aria-hidden="true">
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
                          </svg>
                        </a>`
                      : ""
                  }
                </div>

                <p
                  class="text-xs sm:text-sm text-zinc-400 mt-3 h-24 overflow-hidden text-ellipsis line-clamp-4 leading-relaxed"
                  title="${desc}"
                >
                  ${desc}
                </p>
              </div>
            </div>
          `;
        })
        .join("");

      // 4. Actualizar Contadores y Estados
      if (visibleCountEl) {
        visibleCountEl.textContent = String(filtered.length);
        visibleCountEl.style.transform = "scale(1.25)";
        setTimeout(() => {
          if (visibleCountEl) visibleCountEl.style.transform = "scale(1)";
        }, 180);
      }
      if (totalCountEl) totalCountEl.textContent = String(allProjects.length);

      if (noResultsEl) {
        if (filtered.length === 0) {
          noResultsEl.classList.remove("hidden");
          noResultsEl.classList.add("flex");
        } else {
          noResultsEl.classList.add("hidden");
          noResultsEl.classList.remove("flex");
        }
      }
    }

    // Manejo de eventos centralizado por delegación en controlsSection
    if (controlsSection) {
      controlsSection.onclick = (e) => {
        const target = e.target;

        // Clic en botón de filtro
        const filterBtn = target.closest(".filter-tag-btn");
        if (filterBtn) {
          const filter = filterBtn.getAttribute("data-filter");
          if (filter) {
            currentFilter = filter;
            renderFilterButtons();
            renderProjects();
          }
          return;
        }

        // Clic en botón de ordenamiento
        const sortBtn = target.closest(".sort-btn");
        if (sortBtn) {
          const sort = sortBtn.getAttribute("data-sort");
          if (sort) {
            currentSort = sort;

            const allSortBtns = controlsSection.querySelectorAll(".sort-btn");
            allSortBtns.forEach((b) => b.classList.remove("active-sort"));
            sortBtn.classList.add("active-sort");

            if (sortStatusEl) {
              if (sort === "name-asc") sortStatusEl.textContent = "Orden: Nombre (A-Z)";
              else if (sort === "name-desc") sortStatusEl.textContent = "Orden: Nombre (Z-A)";
              else if (sort === "tech-asc") sortStatusEl.textContent = "Orden: Lenguaje (A-Z)";
            }

            renderProjects();
          }
          return;
        }
      };
    }

    // Buscador interactivo
    if (searchInput) {
      searchInput.oninput = (e) => {
        currentSearch = e.target.value;
        renderProjects();
      };
    }

    // Botón de restablecer
    if (resetBtn) {
      resetBtn.onclick = () => {
        currentFilter = "all";
        currentSearch = "";
        if (searchInput) searchInput.value = "";
        renderFilterButtons();
        renderProjects();
      };
    }

    // Sincronización en vivo con la API de GitHub
    async function syncLiveFromGitHub() {
      try {
        const res = await fetch("https://api.github.com/users/CarlosGaubert/repos?sort=updated&per_page=100");
        if (!res.ok) return;
        const repos = await res.json();
        if (!Array.isArray(repos) || repos.length === 0) return;

        const nonForkRepos = repos.filter((r) => !r.fork);
        if (nonForkRepos.length === 0) return;

        allProjects = nonForkRepos.map((repo) => {
          const desc = repo.description || "Sin descripción disponible.";
          return {
            nameProject: repo.name,
            descriptionProject: desc,
            githubUrl: repo.html_url,
            language: extractMainLang(repo.language, repo.name, desc)
          };
        });

        const badge = document.getElementById("github-sync-badge");
        if (badge) badge.textContent = `GitHub en Vivo (${allProjects.length} repositorios)`;

        renderFilterButtons();
        renderProjects();
      } catch (e) {
        console.error("Error sincronizando repositorios desde GitHub:", e);
      }
    }

    renderFilterButtons();
    renderProjects();
    syncLiveFromGitHub();
  }

  // Inicialización con soporte total para View Transitions de Astro
  document.addEventListener("astro:page-load", setupProjectControls);
</script>

