---
import Layout from "@/layouts/Layout.astro";
import ProfileImage from "@/components/ProfileImage.astro";
import { slide } from "astro:transitions";
---

<Layout title="Carlos Gaubert | Portafolio">
  <main
    class="flex flex-col items-center justify-center min-h-screen w-full md:mb-0"
    transition:animate={slide({
      duration: "0.8s",
    })}
    transition:name="main"
  >
    <div class="flex md:flex-row flex-col flex-grow flex-1 w-full pt-5 md:pt-0 items-center justify-between">
      <div
        class="md:flex-1 pt-24 md:pt-0 flex flex-col gap-5 pl-10 pr-10 md:pl-28 md:pr-20 justify-center"
      >
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-900/80 border border-zinc-800 text-xs font-semibold text-[#00ccff] w-fit shadow-sm backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-[#00ccff] animate-ping"></span>
          <span>Desarrollador & Investigador IA</span>
        </div>
        <h1 class="lg:text-6xl text-4xl font-extrabold text-white tracking-tight">
          Hola, soy <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#00ccff] to-[#d500f9]">Carlos Gaubert</span>.
        </h1>
        <p class="text-lg text-zinc-300 leading-relaxed max-w-2xl">
          Ingeniero de software apasionado por la tecnología, la inteligencia artificial y el desarrollo de sistemas robustos y escalables.
        </p>

        <p class="text-base text-zinc-400">
          Explora mis
          <a
            class="font-bold text-[#00ccff] hover:underline transition-colors"
            href="/portafolio-carlos-astro/projects/">Proyectos</a
          > o revisa mi código en <a
            class="font-bold text-[#00ccff] hover:underline transition-colors"
            href="https://github.com/CarlosGaubert"
            target="_blank"
            rel="noopener noreferrer">GitHub</a
          >.
        </p>
      </div>
      <div
        class="flex pt-12 md:pt-0 items-center justify-center md:flex-1 md:pr-20 xl:pr-32 mb-16 md:mb-0"
      >
        <ProfileImage />
      </div>
    </div>
  </main>
</Layout>
