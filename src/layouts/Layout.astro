---
import { ViewTransitions } from "astro:transitions";
import Navbar from "@/components/Navbar.astro";
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/portafolio-carlos-astro/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/portafolio-carlos-astro/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/portafolio-carlos-astro/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/portafolio-carlos-astro/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/portafolio-carlos-astro/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body>
    <Navbar />
    <div id="stars-container" transition:persist="stars-bg" class="fixed inset-0 pointer-events-none -z-10 overflow-hidden" aria-hidden="true">
      <div class="star star1"></div>
      <div class="star star2"></div>
      <div class="star star3"></div>
      <div class="star star4"></div>
      <div class="star star5"></div>
      <div class="star star6"></div>
      <div class="star star7"></div>
      <div class="star star8"></div>
    </div>

    <slot />

    <!-- Luz / Spotlight Seguidor del Puntero en Viewport Fijo -->
    <div id="cursor-glow" transition:persist="mouse-glow" class="cursor-glow" aria-hidden="true"></div>

    <script is:inline>
      (function () {
        // Promover el contenedor de estrellas y el brillo al elemento raíz <html> antes del body
        // De esta manera se mantienen continuos durante transiciones pero SIEMPRE detrás del contenido
        function promotePersistentBackground() {
          const stars = document.getElementById("stars-container");
          if (stars && stars.parentElement !== document.documentElement) {
            document.documentElement.insertBefore(stars, document.body);
          }
          const glow = document.getElementById("cursor-glow");
          if (glow && glow.parentElement !== document.documentElement) {
            document.documentElement.insertBefore(glow, document.body);
          }
        }
        promotePersistentBackground();

        if (window.__cursorGlowInitialized) return;
        window.__cursorGlowInitialized = true;

        // Desactivar en dispositivos sin puntero de precisión (táctil / móvil) para ahorrar recursos
        const isFinePointer = window.matchMedia("(pointer: fine)").matches;
        if (!isFinePointer) return;

        let mouseX = -1000;
        let mouseY = -1000;
        let currentX = -1000;
        let currentY = -1000;
        let isVisible = false;
        let isAnimating = false;
        let isTransitioning = false;

        function getGlowEl() {
          return document.getElementById("cursor-glow");
        }

        window.addEventListener("mousemove", function (e) {
          mouseX = e.clientX;
          mouseY = e.clientY;
          const glow = getGlowEl();
          if (!isVisible && glow) {
            isVisible = true;
            glow.style.opacity = "1";
          }
          if (!isAnimating && !isTransitioning) {
            isAnimating = true;
            requestAnimationFrame(animateCursorGlow);
          }
        }, { passive: true });

        document.addEventListener("mouseleave", function () {
          isVisible = false;
          const glow = getGlowEl();
          if (glow) glow.style.opacity = "0";
        });

        // Suspender el bucle rAF del cursor durante la animación de transición de página
        document.addEventListener("astro:before-preparation", function () {
          isTransitioning = true;
        });
        document.addEventListener("astro:page-load", function () {
          isTransitioning = false;
          promotePersistentBackground();
        });

        function animateCursorGlow() {
          if (!isAnimating) return;
          if (isTransitioning) {
            isAnimating = false;
            return;
          }

          const glow = getGlowEl();
          if (glow && isVisible) {
            const dx = mouseX - currentX;
            const dy = mouseY - currentY;
            currentX += dx * 0.18;
            currentY += dy * 0.18;
            glow.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) translate(-50%, -50%)`;

            // Suspender rAF cuando el mouse está en reposo (evita drenaje de CPU y GPU)
            if (Math.abs(dx) < 0.2 && Math.abs(dy) < 0.2) {
              isAnimating = false;
              return;
            }
          } else {
            isAnimating = false;
            return;
          }
          requestAnimationFrame(animateCursorGlow);
        }
      })();
    </script>

    <script>
      // Evitar que el nuevo documento cree duplicados en el body durante la navegación
      document.addEventListener("astro:before-swap", (e: any) => {
        if (e.newDocument) {
          const newStars = e.newDocument.getElementById("stars-container");
          if (newStars) newStars.remove();
          const newGlow = e.newDocument.getElementById("cursor-glow");
          if (newGlow) newGlow.remove();
        }
      });
    </script>
    <style is:global>
      :root,
      html {
        view-transition-name: none !important;
      }

      ::view-transition-old(root),
      ::view-transition-new(root) {
        display: none !important;
        animation: none !important;
      }

      #stars-container,
      #stars-container * {
        view-transition-name: none !important;
      }

      #stars-container {
        position: fixed;
        inset: 0;
        z-index: -10;
        pointer-events: none;
        contain: strict;
        transform: translateZ(0);
        will-change: transform;
      }

      #cursor-glow {
        view-transition-name: none !important;
      }
      body {
        --sb-track-color: #232e33;
        --sb-thumb-color: #211f1f;
        --sb-size: 0px;
      }

      body::-webkit-scrollbar {
        width: var(--sb-size);
      }

      body::-webkit-scrollbar-track {
        background: var(--sb-track-color);
        border-radius: 27px;
      }

      body::-webkit-scrollbar-thumb {
        background: var(--sb-thumb-color);
        border-radius: 27px;
      }

      @supports not selector(::-webkit-scrollbar) {
        body {
          scrollbar-color: var(--sb-thumb-color) var(--sb-track-color);
        }
      }

      html {
        font-family: "Montserrat", system-ui, sans-serif;
        background: #000000;
        color: White;
      }
      body {
        margin: 0;
        height: 100dvh;
        position: relative;
        z-index: 1;
      }

      .star {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: -10;
        contain: paint;
        backface-visibility: hidden;
        transform: translate3d(0, 0, 0);
        will-change: transform, opacity;
        animation:
          animate 8s ease-in-out infinite,
          backgroundmove 16s linear infinite;
      }

      .star1 {
        animation-delay: 0s;
        background: url("/portafolio-carlos-astro/stars/star1.webp");
      }

      .star2 {
        animation-delay: -1s;
        background: url("/portafolio-carlos-astro/stars/star2.webp");
      }

      .star3 {
        animation-delay: -2s;
        background: url("/portafolio-carlos-astro/stars/star3.webp");
      }

      .star4 {
        animation-delay: -3s;
        background: url("/portafolio-carlos-astro/stars/star4.webp");
      }

      .star5 {
        animation-delay: -4s;
        background: url("/portafolio-carlos-astro/stars/star5.webp");
      }

      .star6 {
        animation-delay: -5s;
        background: url("/portafolio-carlos-astro/stars/star6.webp");
      }

      .star7 {
        animation-delay: -6s;
        background: url("/portafolio-carlos-astro/stars/star7.webp");
      }

      .star8 {
        animation-delay: -7s;
        background: url("/portafolio-carlos-astro/stars/star8.webp");
      }

      @keyframes animate {
        0%,
        20%,
        40%,
        60%,
        80%,
        100% {
          opacity: 0;
        }
        10%,
        30%,
        50%,
        70%,
        90% {
          opacity: 1;
        }
      }

      @keyframes backgroundmove {
        0% {
          transform: translate3d(0, 0, 0) scale(1);
        }
        100% {
          transform: translate3d(0, 0, 0) scale(2);
        }
      }

      .cursor-glow {
        position: fixed;
        top: 0;
        left: 0;
        width: 500px;
        height: 500px;
        border-radius: 50%;
        pointer-events: none;
        background: radial-gradient(
          circle,
          rgba(0, 204, 255, 0.12) 0%,
          rgba(213, 0, 249, 0.06) 45%,
          transparent 70%
        );
        transform: translate3d(-1000px, -1000px, 0) translate(-50%, -50%);
        opacity: 0;
        transition: opacity 0.3s ease;
        z-index: -5;
        contain: strict;
        will-change: transform, opacity;
      }

      ::view-transition-group(main) {
        animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
        will-change: transform, opacity;
      }

      ::view-transition-old(main),
      ::view-transition-new(main) {
        backface-visibility: hidden;
        transform: translateZ(0);
        will-change: transform, opacity;
      }

      @keyframes smoothFadeOut {
        from {
          opacity: 1;
          transform: translate3d(0, 0, 0);
        }
        to {
          opacity: 0;
          transform: translate3d(0, -8px, 0);
        }
      }

      @keyframes smoothFadeIn {
        from {
          opacity: 0;
          transform: translate3d(0, 10px, 0);
        }
        to {
          opacity: 1;
          transform: translate3d(0, 0, 0);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .star {
          animation: animate 12s ease-in-out infinite !important;
        }
        @keyframes smoothFadeOut {
          to {
            opacity: 0;
          }
        }
        @keyframes smoothFadeIn {
          from {
            opacity: 0;
          }
          to {
            opacity: 1;
          }
        }
      }
    </style>
  </body>
</html>
