---
import { ViewTransitions } from "astro:transitions";
import Navbar from "@/components/Navbar.astro";
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/portafolio-carlos-astro/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body>
    <Navbar />
    <div id="stars-container" transition:persist="stars-bg" class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
      <div class="star star1"></div>
      <div class="star star2"></div>
      <div class="star star3"></div>
      <div class="star star4"></div>
      <div class="star star5"></div>
      <div class="star star6"></div>
      <div class="star star7"></div>
      <div class="star star8"></div>
    </div>

    <slot />

    <!-- Luz / Spotlight Seguidor del Puntero en Viewport Fijo -->
    <div id="cursor-glow" transition:persist="mouse-glow" class="cursor-glow" aria-hidden="true"></div>

    <script is:inline>
      (function () {
        let mouseX = -1000;
        let mouseY = -1000;
        let currentX = -1000;
        let currentY = -1000;
        let isVisible = false;

        function getGlowEl() {
          return document.getElementById("cursor-glow");
        }

        window.addEventListener("mousemove", function (e) {
          mouseX = e.clientX;
          mouseY = e.clientY;
          const glow = getGlowEl();
          if (!isVisible && glow) {
            isVisible = true;
            glow.style.opacity = "1";
          }
        });

        document.addEventListener("mouseleave", function () {
          isVisible = false;
          const glow = getGlowEl();
          if (glow) glow.style.opacity = "0";
        });

        function animateCursorGlow() {
          const glow = getGlowEl();
          if (glow && isVisible) {
            currentX += (mouseX - currentX) * 0.18;
            currentY += (mouseY - currentY) * 0.18;
            glow.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) translate(-50%, -50%)`;
          }
          requestAnimationFrame(animateCursorGlow);
        }
        requestAnimationFrame(animateCursorGlow);
      })();
    </script>

    <script>
      // Preservar la continuidad fluida de las animaciones de las estrellas
      let starAnimationStates: { name: string; currentTime: CSSNumberish | null }[][] = [];

      document.addEventListener("astro:before-swap", () => {
        const stars = document.querySelectorAll("#stars-container .star");
        starAnimationStates = Array.from(stars).map((star) => {
          return star.getAnimations().map((anim) => ({
            name: "animationName" in anim ? (anim as any).animationName : "",
            currentTime: anim.currentTime,
          }));
        });
      });

      document.addEventListener("astro:after-swap", () => {
        const stars = document.querySelectorAll("#stars-container .star");
        stars.forEach((star, index) => {
          const savedAnims = starAnimationStates[index];
          if (!savedAnims) return;

          requestAnimationFrame(() => {
            const currentAnims = star.getAnimations();
            currentAnims.forEach((anim) => {
              const animName = "animationName" in anim ? (anim as any).animationName : "";
              const saved = savedAnims.find((sa) => sa.name === animName);
              if (saved && saved.currentTime !== null) {
                anim.currentTime = saved.currentTime;
              }
            });
          });
        });
      });
    </script>
    <style is:global>
      #stars-container,
      #stars-container * {
        view-transition-name: none !important;
      }
      body {
        --sb-track-color: #232e33;
        --sb-thumb-color: #211f1f;
        --sb-size: 0px;
      }

      body::-webkit-scrollbar {
        width: var(--sb-size);
      }

      body::-webkit-scrollbar-track {
        background: var(--sb-track-color);
        border-radius: 27px;
      }

      body::-webkit-scrollbar-thumb {
        background: var(--sb-thumb-color);
        border-radius: 27px;
      }

      @supports not selector(::-webkit-scrollbar) {
        body {
          scrollbar-color: var(--sb-thumb-color) var(--sb-track-color);
        }
      }

      html {
        font-family: "Montserrat", system-ui, sans-serif;
        background: #000000;
        color: White;
      }
      body {
        margin: 0;
        height: 100dvh;
      }

      .star {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        animation:
          animate 8s ease-in-out infinite,
          backgroundmove 16s linear infinite;
      }

      .star1 {
        animation-delay: 0s;
        background: url("/portafolio-carlos-astro/stars/star1.png");
      }

      .star2 {
        animation-delay: -1s;
        background: url("/portafolio-carlos-astro/stars/star2.png");
      }

      .star3 {
        animation-delay: -2s;
        background: url("/portafolio-carlos-astro/stars/star3.png");
      }

      .star4 {
        animation-delay: -3s;
        background: url("/portafolio-carlos-astro/stars/star4.png");
      }

      .star5 {
        animation-delay: -4s;
        background: url("/portafolio-carlos-astro/stars/star5.png");
      }

      .star6 {
        animation-delay: -5s;
        background: url("/portafolio-carlos-astro/stars/star6.png");
      }

      .star7 {
        animation-delay: -6s;
        background: url("/portafolio-carlos-astro/stars/star7.png");
      }

      .star8 {
        animation-delay: -7s;
        background: url("/portafolio-carlos-astro/stars/star8.png");
      }

      @keyframes animate {
        0%,
        20%,
        40%,
        60%,
        80%,
        100% {
          opacity: 0;
        }
        10%,
        30%,
        50%,
        70%,
        90% {
          opacity: 1;
        }
      }

      @keyframes backgroundmove {
        0% {
          transform: scale(1);
        }
        100% {
          transform: scale(2);
        }
      }

      .cursor-glow {
        position: fixed;
        top: 0;
        left: 0;
        width: 500px;
        height: 500px;
        border-radius: 50%;
        pointer-events: none;
        background: radial-gradient(
          circle,
          rgba(0, 204, 255, 0.12) 0%,
          rgba(213, 0, 249, 0.06) 45%,
          transparent 70%
        );
        transform: translate3d(-1000px, -1000px, 0) translate(-50%, -50%);
        opacity: 0;
        transition: opacity 0.3s ease;
        z-index: 1;
        mix-blend-mode: screen;
        will-change: transform, opacity;
      }
    </style>
  </body>
</html>
