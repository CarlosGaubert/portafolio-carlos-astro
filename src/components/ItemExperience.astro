---
import { getTechIconUrl } from "@/lib/dataProjects";

interface Props {
  dateExperience: string;
  titleExperience: string;
  descriptionExperience: string;
  companyExperience: string;
  cityCompanyExperience: string;
  isCurrent?: boolean;
  technologies?: string[];
}

const {
  dateExperience,
  titleExperience,
  descriptionExperience,
  companyExperience,
  cityCompanyExperience,
  isCurrent = false,
  technologies = [],
} = Astro.props;
---

<li class="relative pl-8 sm:pl-12 pb-12 last:pb-2 group">
  <!-- Línea conectora vertical de la timeline -->
  <div
    class="absolute left-[11px] sm:left-[15px] top-6 bottom-0 w-[2px] bg-gradient-to-b from-[#00ccff]/50 via-zinc-800 to-zinc-800/20 group-last:hidden"
  ></div>

  <!-- Nodo / Punto de la Línea de Tiempo -->
  <div
    class={`absolute left-0 sm:left-1 top-1.5 w-6 h-6 sm:w-7 sm:h-7 rounded-full flex items-center justify-center border-2 transition-all duration-300 z-10 ${
      isCurrent
        ? "bg-emerald-950/90 border-emerald-400 text-emerald-300 shadow-[0_0_15px_rgba(52,211,153,0.5)]"
        : "bg-zinc-950 border-[#00ccff]/60 group-hover:border-[#d500f9] group-hover:shadow-[0_0_15px_rgba(0,204,255,0.4)] text-[#00ccff]"
    }`}
  >
    {isCurrent ? (
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
    ) : (
      <span class="w-2 h-2 rounded-full bg-gradient-to-r from-[#00ccff] to-[#d500f9]"></span>
    )}
  </div>

  <!-- Tarjeta de Experiencia Glassmorphism -->
  <div
    class="relative rounded-2xl bg-zinc-950/70 border border-zinc-800/80 p-6 sm:p-7 backdrop-blur-xl shadow-xl hover:border-[#00ccff]/50 transition-all duration-300 transform hover:-translate-y-1 hover:shadow-2xl overflow-hidden"
  >
    <!-- Gradiente ambiental de fondo -->
    <div
      class="absolute -right-12 -top-12 w-36 h-36 bg-gradient-to-br from-[#00ccff]/10 to-[#d500f9]/10 rounded-full blur-3xl pointer-events-none group-hover:opacity-100 transition-opacity"
    ></div>

    <!-- Header de la tarjeta: Rol, Empresa y Fecha -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
      <div class="flex flex-col">
        <div class="flex items-center gap-2 flex-wrap">
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-gradient-to-r group-hover:from-white group-hover:to-[#00ccff] transition-all">
            {titleExperience}
          </h2>
          {isCurrent && (
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-950/80 border border-emerald-500/30 text-[11px] font-semibold text-emerald-400 shadow-sm">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              Actual
            </span>
          )}
        </div>

        <!-- Empresa y Ciudad -->
        <div class="flex items-center gap-2 text-sm text-zinc-400 mt-1 flex-wrap font-medium">
          <span class="text-[#00ccff] font-semibold flex items-center gap-1.5">
            <svg class="w-4 h-4 text-[#00ccff]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
            {companyExperience}
          </span>
          <span class="text-zinc-600">•</span>
          <span class="flex items-center gap-1 text-zinc-400">
            <svg class="w-3.5 h-3.5 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            {cityCompanyExperience}
          </span>
        </div>
      </div>

      <!-- Badge de Fecha -->
      <div class="flex-shrink-0">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-zinc-900/90 border border-zinc-800 text-xs font-mono text-zinc-300">
          <svg class="w-3.5 h-3.5 text-[#00ccff]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          {dateExperience}
        </span>
      </div>
    </div>

    <!-- Descripción del puesto -->
    <p class="text-sm sm:text-base text-zinc-300 leading-relaxed font-normal mb-5">
      {descriptionExperience}
    </p>

    <!-- Tecnologías Utilizadas -->
    {technologies && technologies.length > 0 && (
      <div class="pt-4 border-t border-zinc-800/60 flex flex-wrap items-center gap-2">
        <span class="text-xs font-semibold uppercase tracking-wider text-zinc-500 mr-1 flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
          Tecnologías:
        </span>
        {technologies.map((tech) => {
          const iconUrl = getTechIconUrl(tech);
          return (
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-zinc-900/80 border border-zinc-800 text-xs font-medium text-zinc-300 hover:border-[#00ccff]/50 hover:bg-zinc-800/80 transition-colors shadow-sm">
              {iconUrl && (
                <img
                  src={iconUrl}
                  alt=""
                  class="w-3.5 h-3.5 object-contain"
                  onerror="this.style.display='none'"
                />
              )}
              <span>{tech}</span>
            </span>
          );
        })}
      </div>
    )}
  </div>
</li>

