---
const currentPath = Astro.url.pathname;

const navItems = [
  { name: "Inicio", href: "/portafolio-carlos-astro/" },
  { name: "Proyectos", href: "/portafolio-carlos-astro/projects/" },
  { name: "Contribuciones", href: "/portafolio-carlos-astro/contributions/", isGithub: true },
  { name: "Experiencia", href: "/portafolio-carlos-astro/experience/" },
  { name: "Contacto", href: "/portafolio-carlos-astro/contact/" },
];

function isPathActive(href: string) {
  const cleanHref = href.replace(/\/+$/, "");
  const cleanCurrent = currentPath.replace(/\/+$/, "");
  if (cleanHref === "" || cleanHref === "/portafolio-carlos-astro") {
    return cleanCurrent === "" || cleanCurrent === "/portafolio-carlos-astro";
  }
  return cleanCurrent.startsWith(cleanHref);
}
---

<nav
  transition:persist
  class="fixed top-0 left-0 right-0 z-50 flex items-center justify-center pt-4 px-2 sm:px-4 pointer-events-none"
>
  <div class="pointer-events-auto bg-zinc-950/80 border border-zinc-800/80 backdrop-blur-xl rounded-full px-3 sm:px-5 py-2 sm:py-2.5 shadow-2xl flex items-center space-x-1 sm:space-x-2.5 text-xs sm:text-sm font-medium overflow-x-auto max-w-[95vw] scrollbar-none">
    {
      navItems.map((item) => {
        const active = isPathActive(item.href);
        return (
          <a
            href={item.href}
            data-nav-link
            data-href={item.href}
            class={`nav-link px-2.5 sm:px-3 py-1.5 rounded-full transition-all duration-300 border flex items-center gap-1.5 whitespace-nowrap flex-shrink-0 ${
              active
                ? "bg-gradient-to-r from-[#00ccff]/20 to-[#d500f9]/20 text-white border-[#00ccff]/50 shadow-[0_0_12px_rgba(0,204,255,0.3)]"
                : "text-zinc-400 hover:text-white hover:bg-zinc-800/60 border-transparent"
            }`}
          >
            {item.isGithub && (
              <svg class="w-3.5 h-3.5 fill-current opacity-90 flex-shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
              </svg>
            )}
            <span>{item.name}</span>
          </a>
        );
      })
    }
  </div>
</nav>

<script>
  const activeClasses = [
    "bg-gradient-to-r",
    "from-[#00ccff]/20",
    "to-[#d500f9]/20",
    "text-white",
    "border-[#00ccff]/50",
    "shadow-[0_0_12px_rgba(0,204,255,0.3)]",
  ];

  const inactiveClasses = [
    "text-zinc-400",
    "hover:text-white",
    "hover:bg-zinc-800/60",
    "border-transparent",
  ];

  function updateActiveNavLink() {
    const current = window.location.pathname.replace(/\/+$/, "");
    const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");

    links.forEach((link) => {
      const rawHref = link.getAttribute("data-href") || link.getAttribute("href") || "";
      const cleanHref = rawHref.replace(/\/+$/, "");

      const isHome = cleanHref === "" || cleanHref === "/portafolio-carlos-astro";
      const isCurrentHome = current === "" || current === "/portafolio-carlos-astro";

      const isActive = isHome ? isCurrentHome : current.startsWith(cleanHref);

      if (isActive) {
        link.classList.remove(...inactiveClasses);
        link.classList.add(...activeClasses);
      } else {
        link.classList.remove(...activeClasses);
        link.classList.add(...inactiveClasses);
      }
    });
  }

  document.addEventListener("astro:page-load", updateActiveNavLink);
</script>
