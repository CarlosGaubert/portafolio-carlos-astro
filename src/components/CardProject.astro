---
interface Props {
  nameProject: string;
  descriptionProject: string;
  githubUrl: string;
  language?: string;
  id?: string;
  index?: number;
}

const { nameProject, descriptionProject, githubUrl, language = "General", id, index = 0 } = Astro.props;
import { getTechIconUrl, getTechGradient } from "@/lib/dataProjects";

const cardId = id || nameProject.toLowerCase().replace(/[^a-z0-9]/g, "-").replace(/-+/g, "-").replace(/^-|-$/g, "");
const primaryLang = language || "General";
const primaryIcon = getTechIconUrl(primaryLang);
const gradientClass = getTechGradient(primaryLang);
const delayMs = Math.min(index * 35, 350);
---

<div
  class="project-card box place-self-center grid-item w-full max-w-[400px]"
  data-name={nameProject.toLowerCase()}
  data-tech={primaryLang.toLowerCase()}
  data-id={cardId}
  style={`--card-delay: ${delayMs}ms;`}
>
  <!-- Header / Banner de Tecnología Online -->
  <div class={`tech-banner w-full h-28 z-20 overflow-hidden rounded-t-[16px] relative bg-gradient-to-br ${gradientClass} flex items-center justify-between px-6 border-b border-zinc-800/80`}>
    <div class="flex items-center gap-3.5 z-10">
      <div class="w-12 h-12 rounded-xl bg-zinc-950/80 border border-white/10 p-2 flex items-center justify-center shadow-lg backdrop-blur-md">
        <img
          src={primaryIcon}
          alt={primaryLang}
          class="w-8 h-8 object-contain filter drop-shadow"
          onerror="this.style.display='none'"
        />
      </div>
      <div class="flex flex-col">
        <span class="text-xs font-semibold uppercase tracking-wider text-zinc-400">Lenguaje</span>
        <span class="text-sm font-bold text-white tracking-wide">{primaryLang}</span>
      </div>
    </div>

    <!-- Píldora de estado -->
    <div class="hidden sm:flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-black/40 border border-white/10 text-[10px] font-mono text-zinc-300 backdrop-blur-sm z-10">
      <span class="w-1.5 h-1.5 rounded-full bg-[#00ccff]"></span>
      <span>Repo</span>
    </div>

    <!-- Brillo sutil ambiental -->
    <div class="absolute -right-8 -top-8 w-24 h-24 bg-[#00ccff]/10 rounded-full blur-2xl pointer-events-none"></div>
  </div>

  <!-- Contenido de la Tarjeta -->
  <div class="relative w-full flex flex-col flex-1 p-5 z-20">
    <div class="flex flex-row justify-between items-start gap-2">
      <h3 class="text-lg font-bold text-white tracking-wide line-clamp-1 hover:text-[#00ccff] transition-colors" title={nameProject}>
        {nameProject}
      </h3>

      {githubUrl && (
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="github-icon flex-shrink-0 flex items-center justify-center p-2 rounded-xl bg-zinc-800/90 hover:bg-[#00ccff]/20 border border-zinc-600 hover:border-[#00ccff] text-white hover:text-[#00ccff] transition-all duration-300 transform hover:scale-110 shadow-md"
          title="Ver repositorio en GitHub"
          aria-label={`Ver repositorio de ${nameProject} en GitHub`}
        >
          <!-- SVG Blanco Nítido de GitHub -->
          <svg class="w-5 h-5 fill-current text-white" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
          </svg>
        </a>
      )}
    </div>

    <p
      class="text-xs sm:text-sm text-zinc-400 mt-3 h-24 overflow-hidden text-ellipsis line-clamp-4 leading-relaxed"
      title={descriptionProject}
    >
      {descriptionProject}
    </p>
  </div>
</div>

<style is:global>
  .project-card.box {
    position: relative;
    height: 290px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    background: rgba(20, 20, 24, 0.85);
    border: 1px solid rgba(63, 63, 70, 0.5);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 4px 20px -4px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(12px);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .project-card.box:hover {
    border-color: rgba(0, 204, 255, 0.5);
    box-shadow:
      0 12px 30px -10px rgba(0, 204, 255, 0.25),
      0 0 15px rgba(213, 0, 249, 0.15);
    transform: translateY(-4px) scale(1.02);
  }

  .tech-banner {
    position: relative;
  }
</style>

