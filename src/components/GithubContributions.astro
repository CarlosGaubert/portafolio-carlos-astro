---
interface Props {
  username?: string;
}

const { username = "CarlosGaubert" } = Astro.props;

// Intentar obtener datos reales durante el build estático
let initialData: any = null;

try {
  const res = await fetch(`https://github-contributions-api.jogruber.de/v4/${username}`);
  if (res.ok) {
    initialData = await res.json();
  }
} catch (e) {
  // Durante el build sin red o en sandbox, usar datos reales verificados
}

if (!initialData || !initialData.contributions) {
  initialData = {
    total: { "2024": 1, "2025": 0, "2026": 8 },
    contributions: [
      { date: "2024-10-26", count: 1, level: 4 },
      { date: "2026-07-26", count: 2, level: 4 },
      { date: "2026-08-09", count: 1, level: 4 },
      { date: "2026-08-13", count: 2, level: 4 },
      { date: "2026-08-15", count: 1, level: 4 },
      { date: "2026-08-17", count: 1, level: 4 },
      { date: "2026-09-04", count: 1, level: 4 }
    ]
  };
}

const availableYears = initialData.total ? Object.keys(initialData.total).sort((a, b) => Number(b) - Number(a)) : ["2026", "2025", "2024"];
const defaultYear = availableYears[0] || "2026";
const defaultTotal = initialData.total?.[defaultYear] ?? 8;

// Generar SVG inicial en el servidor para carga instantánea sin layout shift
const levelColors: Record<number, string> = {
  0: "#161b22",
  1: "#0e4429",
  2: "#006d32",
  3: "#26a641",
  4: "#39d353"
};

const monthNamesEs = ["Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"];

const contribMap = new Map<string, { count: number; level: number }>();
if (Array.isArray(initialData.contributions)) {
  for (const item of initialData.contributions) {
    if (item && item.date) {
      contribMap.set(item.date, item);
    }
  }
}

// Generar cuadrícula del año por defecto
const yrNum = parseInt(defaultYear, 10);
const now = new Date();
const isCurrentYear = now.getUTCFullYear() === yrNum;

// Si es el año actual, mostramos las últimas 52 semanas como en la captura de GitHub
let startDate: Date;
let endDate: Date;

if (isCurrentYear) {
  endDate = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));
  startDate = new Date(endDate);
  startDate.setUTCDate(endDate.getUTCDate() - 364);
} else {
  startDate = new Date(Date.UTC(yrNum, 0, 1));
  endDate = new Date(Date.UTC(yrNum, 11, 31));
}

const firstDayOfWeek = startDate.getUTCDay();
const calendarStart = new Date(startDate);
calendarStart.setUTCDate(startDate.getUTCDate() - firstDayOfWeek);

const diffMs = endDate.getTime() - calendarStart.getTime();
const totalDays = Math.ceil(diffMs / (1000 * 60 * 60 * 24)) + 1;
const totalWeeks = Math.ceil(totalDays / 7);

const cellSize = 10.5;
const cellGap = 3;
const step = cellSize + cellGap;
const leftPad = 28;
const topPad = 20;
const svgWidth = leftPad + totalWeeks * step + 10;
const svgHeight = topPad + 7 * step + 5;

let initialMonthLabels: { text: string; x: number }[] = [];
let lastMonth = -1;
let initialCellsSvg = "";

let cur = new Date(calendarStart);
for (let w = 0; w < totalWeeks; w++) {
  const x = leftPad + w * step;
  for (let d = 0; d < 7; d++) {
    const y = topPad + d * step;
    const dateStr = cur.toISOString().split("T")[0];
    const isWithinRange = cur >= startDate && cur <= endDate;

    const m = cur.getUTCMonth();
    if (m !== lastMonth && isWithinRange && d <= 1) {
      lastMonth = m;
      initialMonthLabels.push({ text: monthNamesEs[m], x: x });
    }

    if (isWithinRange) {
      const dataEntry = contribMap.get(dateStr);
      const count = dataEntry ? dataEntry.count : 0;
      const level = dataEntry ? Math.min(Math.max(dataEntry.level, 0), 4) : 0;
      const color = levelColors[level] || levelColors[0];

      initialCellsSvg += `<rect class="gh-day-cell cursor-pointer transition-all hover:stroke-white hover:stroke-[1.5px]" x="${x}" y="${y}" width="${cellSize}" height="${cellSize}" rx="2" ry="2" fill="${color}" data-date="${dateStr}" data-count="${count}" />`;
    }

    cur.setUTCDate(cur.getUTCDate() + 1);
  }
}

const initialMonthsSvg = initialMonthLabels
  .map((m) => `<text x="${m.x}" y="${topPad - 6}" fill="#71717a" font-size="9.5" font-family="ui-monospace, monospace">${m.text}</text>`)
  .join("");

const dayLabelsSvg = `
  <text x="4" y="${topPad + 1 * step + 8.5}" fill="#71717a" font-size="9" font-family="ui-monospace, monospace">Lun</text>
  <text x="4" y="${topPad + 3 * step + 8.5}" fill="#71717a" font-size="9" font-family="ui-monospace, monospace">Mié</text>
  <text x="4" y="${topPad + 5 * step + 8.5}" fill="#71717a" font-size="9" font-family="ui-monospace, monospace">Vie</text>
`;

const initialSvgHtml = `
  <svg viewBox="0 0 ${svgWidth} ${svgHeight}" class="w-full h-auto overflow-visible select-none" style="min-width: 680px;">
    ${initialMonthsSvg}
    ${dayLabelsSvg}
    ${initialCellsSvg}
  </svg>
`;
---

<section class="github-contributions-section w-full mb-12" data-username={username}>
  <!-- Tarjeta Contenedora Principal -->
  <div class="w-full bg-zinc-950/70 border border-zinc-800/90 rounded-2xl p-4 sm:p-6 lg:p-7 backdrop-blur-xl shadow-2xl relative overflow-hidden">
    <!-- Glow ambiental decorativo -->
    <div class="absolute -top-24 -left-24 w-72 h-72 bg-[#00ccff]/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-72 h-72 bg-[#d500f9]/10 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Encabezado Superior -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6 relative z-10 border-b border-zinc-800/60 pb-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-zinc-900/90 border border-zinc-700/60 flex items-center justify-center text-white shadow-inner">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h2 class="text-base sm:text-lg font-bold text-white tracking-wide">
              Actividad en GitHub
            </h2>
            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              En vivo
            </span>
          </div>
          <p class="text-xs text-zinc-400">
            Registro de avances y commits sincronizados en tiempo real
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2 self-start sm:self-auto">
        <a
          href={`https://github.com/${username}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-zinc-900/90 hover:bg-zinc-800 border border-zinc-700/70 hover:border-[#00ccff]/60 text-xs font-medium text-zinc-300 hover:text-[#00ccff] transition-all shadow-sm group"
          title="Ver perfil completo en GitHub"
        >
          <span>@{username}</span>
          <svg class="w-3.5 h-3.5 text-zinc-400 group-hover:text-[#00ccff] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Layout: Gráfico a la izquierda y Selector de Años a la derecha (Estilo oficial de GitHub) -->
    <div class="flex flex-col lg:flex-row items-start gap-6 relative z-10">
      
      <!-- Contenedor del Gráfico con su caja oscura interior -->
      <div class="w-full flex-1 min-w-0">
        <!-- Título de contribuciones del año activo -->
        <div class="flex items-center justify-between mb-3 px-1">
          <span id="gh-contrib-heading" class="text-sm sm:text-base font-semibold text-white tracking-wide">
            <span id="gh-contrib-count" class="text-[#00ccff] font-bold">{defaultTotal}</span> contribuciones en el último año
          </span>
          <span class="text-xs text-zinc-500 italic hidden sm:inline">
            Horario UTC
          </span>
        </div>

        <!-- Caja oscura del heatmap (Estilo GitHub Dark UI) -->
        <div class="w-full bg-[#0d1117] border border-zinc-800/90 rounded-xl p-4 sm:p-5 shadow-inner relative">
          <!-- Área de Scroll horizontal suave para dispositivos móviles -->
          <div class="overflow-x-auto pb-2 pt-1 scrollbar-thin scrollbar-thumb-zinc-800 scrollbar-track-transparent">
            <div id="gh-calendar-wrapper" class="min-w-[720px] flex flex-col justify-center" set:html={initialSvgHtml}>
            </div>
          </div>

          <!-- Pie del Gráfico (Estilo GitHub) -->
          <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-3 mt-2 border-t border-zinc-800/80 text-xs text-zinc-400">
            <a
              href="https://docs.github.com/articles/why-are-my-contributions-not-showing-up-on-my-profile"
              target="_blank"
              rel="noopener noreferrer"
              class="text-zinc-500 hover:text-zinc-300 transition-colors text-[11px] underline underline-offset-2 flex items-center gap-1"
            >
              <span>Aprende cómo cuenta GitHub las contribuciones</span>
            </a>

            <!-- Leyenda de colores -->
            <div class="flex items-center gap-2 text-[11px] text-zinc-400">
              <span>Menos</span>
              <div class="flex items-center gap-1">
                <span class="w-[11px] h-[11px] rounded-[2px] bg-[#161b22] border border-white/5" title="Sin contribuciones"></span>
                <span class="w-[11px] h-[11px] rounded-[2px] bg-[#0e4429]" title="Nivel 1"></span>
                <span class="w-[11px] h-[11px] rounded-[2px] bg-[#006d32]" title="Nivel 2"></span>
                <span class="w-[11px] h-[11px] rounded-[2px] bg-[#26a641]" title="Nivel 3"></span>
                <span class="w-[11px] h-[11px] rounded-[2px] bg-[#39d353]" title="Nivel 4"></span>
              </div>
              <span>Más</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Barra de Selector de Años (Estilo GitHub en el lateral derecho) -->
      <div class="w-full lg:w-36 flex flex-row lg:flex-col gap-1.5 overflow-x-auto lg:overflow-visible pb-1 lg:pb-0 scrollbar-none flex-shrink-0">
        <span class="text-[11px] font-semibold text-zinc-500 uppercase tracking-wider hidden lg:block mb-1 px-1">
          Años
        </span>
        <div id="gh-years-container" class="flex flex-row lg:flex-col gap-1.5 w-full">
          {availableYears.map((yr, idx) => (
            <button
              type="button"
              data-year={yr}
              class={`gh-year-btn w-full text-left px-3.5 py-1.5 rounded-lg text-xs font-medium transition-all cursor-pointer flex items-center justify-between ${
                idx === 0
                  ? "bg-blue-600 text-white font-semibold shadow-sm"
                  : "text-zinc-400 hover:text-white hover:bg-zinc-900/80"
              }`}
            >
              <span>{yr}</span>
              <span class="text-[10px] opacity-75">{initialData.total?.[yr] ?? 0}</span>
            </button>
          ))}
        </div>
      </div>

    </div>
  </div>

  <!-- Tooltip flotante interactivo -->
  <div
    id="gh-tooltip"
    class="fixed pointer-events-none z-50 px-2.5 py-1.5 rounded-lg bg-zinc-900/95 border border-zinc-700/80 text-white text-[11px] shadow-2xl backdrop-blur-md transition-opacity duration-150 opacity-0 -translate-x-1/2 -translate-y-full -mt-2 whitespace-nowrap"
  >
    <div id="gh-tooltip-text" class="font-medium"></div>
    <div class="absolute left-1/2 -bottom-1 -translate-x-1/2 w-2 h-2 bg-zinc-900 border-b border-r border-zinc-700 rotate-45"></div>
  </div>

  <!-- Script de datos iniciales embebidos -->
  <script id="initial-github-contributions" is:inline type="application/json" set:html={JSON.stringify(initialData)}></script>
</section>

<script is:inline>
  function initGitHubContributions() {
    const section = document.querySelector(".github-contributions-section");
    if (!section) return;

    const username = section.getAttribute("data-username") || "CarlosGaubert";
    const dataScript = document.getElementById("initial-github-contributions");
    const calendarWrapper = document.getElementById("gh-calendar-wrapper");
    const yearsContainer = document.getElementById("gh-years-container");
    const headingEl = document.getElementById("gh-contrib-heading");
    const countEl = document.getElementById("gh-contrib-count");
    const tooltip = document.getElementById("gh-tooltip");
    const tooltipText = document.getElementById("gh-tooltip-text");

    let fullData = null;
    try {
      if (dataScript && dataScript.textContent) {
        fullData = JSON.parse(dataScript.textContent);
      }
    } catch (e) {
      console.error("Error al parsear datos iniciales de contribuciones:", e);
    }

    // Intentar leer caché previo de localStorage
    const cacheKey = `gh_contributions_${username}`;
    try {
      const cached = localStorage.getItem(cacheKey);
      if (cached) {
        const parsed = JSON.parse(cached);
        if (parsed && parsed.total) {
          fullData = parsed;
        }
      }
    } catch (e) {}

    let selectedYear = "2026";
    if (fullData && fullData.total) {
      const yrs = Object.keys(fullData.total).sort((a, b) => Number(b) - Number(a));
      if (yrs.length > 0) selectedYear = yrs[0];
    }

    const levelColors = {
      0: "#161b22",
      1: "#0e4429",
      2: "#006d32",
      3: "#26a641",
      4: "#39d353"
    };

    const monthNamesEs = ["Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"];

    function getContributionsMap() {
      const map = new Map();
      if (fullData && Array.isArray(fullData.contributions)) {
        for (const item of fullData.contributions) {
          if (item && item.date) {
            map.set(item.date, item);
          }
        }
      }
      return map;
    }

    function renderYearButtons() {
      if (!yearsContainer || !fullData || !fullData.total) return;
      const yrs = Object.keys(fullData.total).sort((a, b) => Number(b) - Number(a));

      let html = "";
      yrs.forEach((yr) => {
        const isActive = yr === selectedYear;
        const count = fullData.total[yr] ?? 0;
        html += `
          <button
            type="button"
            data-year="${yr}"
            class="gh-year-btn w-full text-left px-3.5 py-1.5 rounded-lg text-xs font-medium transition-all cursor-pointer flex items-center justify-between ${
              isActive
                ? "bg-blue-600 text-white font-semibold shadow-sm"
                : "text-zinc-400 hover:text-white hover:bg-zinc-900/80"
            }"
          >
            <span>${yr}</span>
            <span class="text-[10px] opacity-75">${count}</span>
          </button>
        `;
      });
      yearsContainer.innerHTML = html;
    }

    function renderCalendar() {
      if (!calendarWrapper) return;
      const contribMap = getContributionsMap();

      const yrNum = parseInt(selectedYear, 10);
      const now = new Date();
      const isCurrentYear = now.getUTCFullYear() === yrNum;

      let startDate;
      let endDate;

      if (isCurrentYear) {
        endDate = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));
        startDate = new Date(endDate);
        startDate.setUTCDate(endDate.getUTCDate() - 364);
      } else {
        startDate = new Date(Date.UTC(yrNum, 0, 1));
        endDate = new Date(Date.UTC(yrNum, 11, 31));
      }

      const firstDayOfWeek = startDate.getUTCDay();
      const calendarStart = new Date(startDate);
      calendarStart.setUTCDate(startDate.getUTCDate() - firstDayOfWeek);

      const diffMs = endDate.getTime() - calendarStart.getTime();
      const totalDays = Math.ceil(diffMs / (1000 * 60 * 60 * 24)) + 1;
      const totalWeeks = Math.ceil(totalDays / 7);

      const cellSize = 10.5;
      const cellGap = 3;
      const step = cellSize + cellGap;
      const leftPad = 28;
      const topPad = 20;

      const svgWidth = leftPad + totalWeeks * step + 10;
      const svgHeight = topPad + 7 * step + 5;

      let monthLabels = [];
      let lastMonth = -1;
      let cellsSvg = "";

      let cur = new Date(calendarStart);
      for (let w = 0; w < totalWeeks; w++) {
        let x = leftPad + w * step;

        for (let d = 0; d < 7; d++) {
          const y = topPad + d * step;
          const dateStr = cur.toISOString().split("T")[0];
          const isWithinRange = cur >= startDate && cur <= endDate;

          const m = cur.getUTCMonth();
          if (m !== lastMonth && isWithinRange && d <= 1) {
            lastMonth = m;
            monthLabels.push({ text: monthNamesEs[m], x: x });
          }

          if (isWithinRange) {
            const dataEntry = contribMap.get(dateStr);
            const count = dataEntry ? dataEntry.count : 0;
            const level = dataEntry ? Math.min(Math.max(dataEntry.level, 0), 4) : 0;
            const color = levelColors[level] || levelColors[0];

            cellsSvg += `
              <rect
                class="gh-day-cell cursor-pointer transition-all hover:stroke-white hover:stroke-[1.5px]"
                x="${x}"
                y="${y}"
                width="${cellSize}"
                height="${cellSize}"
                rx="2"
                ry="2"
                fill="${color}"
                data-date="${dateStr}"
                data-count="${count}"
              />
            `;
          }

          cur.setUTCDate(cur.getUTCDate() + 1);
        }
      }

      const monthsSvg = monthLabels
        .map(
          (m) =>
            `<text x="${m.x}" y="${topPad - 6}" fill="#71717a" font-size="9.5" font-family="ui-monospace, monospace">${m.text}</text>`
        )
        .join("");

      const dayLabelsSvg = `
        <text x="4" y="${topPad + 1 * step + 8.5}" fill="#71717a" font-size="9" font-family="ui-monospace, monospace">Lun</text>
        <text x="4" y="${topPad + 3 * step + 8.5}" fill="#71717a" font-size="9" font-family="ui-monospace, monospace">Mié</text>
        <text x="4" y="${topPad + 5 * step + 8.5}" fill="#71717a" font-size="9" font-family="ui-monospace, monospace">Vie</text>
      `;

      const svgHtml = `
        <svg
          viewBox="0 0 ${svgWidth} ${svgHeight}"
          class="w-full h-auto overflow-visible select-none"
          style="min-width: 680px;"
        >
          ${monthsSvg}
          ${dayLabelsSvg}
          ${cellsSvg}
        </svg>
      `;

      calendarWrapper.innerHTML = svgHtml;

      const yearTotal = fullData?.total?.[selectedYear] ?? 0;
      if (countEl) countEl.textContent = String(yearTotal);
      if (headingEl) {
        const periodText = isCurrentYear ? "en el último año" : `en ${selectedYear}`;
        headingEl.innerHTML = `<span id="gh-contrib-count" class="text-[#00ccff] font-bold">${yearTotal}</span> contribuciones ${periodText}`;
      }

      attachCellListeners();
    }

    function attachCellListeners() {
      const cells = calendarWrapper.querySelectorAll(".gh-day-cell");
      cells.forEach((cell) => {
        cell.onmouseenter = () => {
          const date = cell.getAttribute("data-date");
          const count = parseInt(cell.getAttribute("data-count") || "0", 10);
          if (!date) return;

          const [y, m, d] = date.split("-");
          const monthName = monthNamesEs[parseInt(m, 10) - 1];
          const text =
            count === 0
              ? `Sin contribuciones el ${parseInt(d, 10)} de ${monthName} de ${y}`
              : count === 1
              ? `1 contribución el ${parseInt(d, 10)} de ${monthName} de ${y}`
              : `${count} contribuciones el ${parseInt(d, 10)} de ${monthName} de ${y}`;

          if (tooltip && tooltipText) {
            tooltipText.textContent = text;
            tooltip.style.opacity = "1";

            const rect = cell.getBoundingClientRect();
            tooltip.style.left = `${rect.left + rect.width / 2}px`;
            tooltip.style.top = `${rect.top - 6}px`;
          }
        };

        cell.onmouseleave = () => {
          if (tooltip) tooltip.style.opacity = "0";
        };
      });
    }

    // Eventos de selección de año
    if (yearsContainer) {
      yearsContainer.onclick = (e) => {
        const btn = e.target.closest(".gh-year-btn");
        if (btn) {
          const yr = btn.getAttribute("data-year");
          if (yr && yr !== selectedYear) {
            selectedYear = yr;
            renderYearButtons();
            renderCalendar();
          }
        }
      };
    }

    // Sincronización en vivo con la API
    async function syncLiveContributions() {
      try {
        const res = await fetch(`https://github-contributions-api.jogruber.de/v4/${username}`);
        if (!res.ok) return;
        const freshData = await res.json();
        if (freshData && freshData.total) {
          fullData = freshData;
          try {
            localStorage.setItem(cacheKey, JSON.stringify(freshData));
          } catch (e) {}

          renderYearButtons();
          renderCalendar();
        }
      } catch (err) {
        console.warn("No se pudo sincronizar en vivo con la API de contribuciones:", err);
      }
    }

    renderYearButtons();
    attachCellListeners();
    syncLiveContributions();
  }

  document.addEventListener("astro:page-load", initGitHubContributions);
</script>

<style>
  .gh-year-btn:focus-visible {
    outline: 2px solid #00ccff;
    outline-offset: 2px;
  }
</style>
